#include <stdio.h>
#include <string.h>

// Definisi struktur data untuk menyimpan informasi karyawan
struct Karyawan {
    char nama[50];
    char gender;
    int gaji;
};

// Selection Sort
//Mengurutkan data karyawan berdasarkan 'gaji' secara ascending (dari kecil ke besar)
void selectionSort(struct Karyawan data[], int n) {
    int i, j, min;
    struct Karyawan temp;

    for(i = 0; i < n - 1; i++) {
        min = i;

        for(j = i + 1; j < n; j++) {
            if(data[j].gaji < data[min].gaji) {
                min = j;
            }
        }

        temp = data[i];
        data[i] = data[min];
        data[min] = temp;
    }
}

// Linear Search berdasarkan nama
// Mencari data karyawan secara berurutan dari awal sampai akhir berdasarkan 'nama'
// Mengembalikan indeks jika ketemu, atau -1 jika tidak ketemu
int linearSearch(struct Karyawan data[], int n, char namaCari[]) {
    int i;

    for(i = 0; i < n; i++) {
        if(strcmp(data[i].nama, namaCari) == 0) {
            return i;
        }
    }

    return -1;
}

// Binary Search berdasarkan gaji
// Mencari data karyawan berdasarkan 'gaji'. 
// Hanya bekerja jika data sudah terurut (dalam program ini diurutkan oleh Selection Sort)
int binarySearch(struct Karyawan data[], int n, int target) {
    int kiri = 0;
    int kanan = n - 1;

    while(kiri <= kanan) {
        int tengah = (kiri + kanan) / 2;

        if(data[tengah].gaji == target) {
            return tengah;
        }
        else if(data[tengah].gaji < target) {
            kiri = tengah + 1;
        }
        else {
            kanan = tengah - 1;
        }
    }

    return -1;
}

void tampilRupiah(int angka) {
    if (angka >= 1000000)
        printf("Rp%d.%03d.%03d",
               angka / 1000000,
               (angka / 1000) % 1000,
               angka % 1000);
    else if (angka >= 1000)
        printf("Rp%d.%03d",
               angka / 1000,
               angka % 1000);
    else
        printf("Rp%d", angka);
}


